# Base URL for the original site's images, videos and PDFs.
# Default "/legacy/" is proxied to http://amaltasgroup.co.in/paramedical/ by
# vercel.json / public/_redirects / vite.config.ts. Do NOT set an http:// URL here
# for an HTTPS deployment: browsers block HTTP images on HTTPS pages (mixed content).
VITE_ASSET_BASE=/legacy/

# Optional: endpoint that accepts the enquiry form as JSON (POST).
# Leave empty to fall back to opening the visitor's email app.
VITE_ENQUIRY_ENDPOINT=

# Optional: sub-folder the built site is served from, e.g. /paramedical/
VITE_BASE_PATH=/
