# Base URL where the original site's images, videos and PDFs live.
# The live server is HTTP-only today. If you deploy this React site over HTTPS,
# browsers will block HTTP images (mixed content) — see README "Assets" section.
VITE_ASSET_BASE=http://amaltasgroup.co.in/paramedical/

# Optional: endpoint that accepts the enquiry form as JSON (POST).
# Leave empty to fall back to opening the visitor's email app.
VITE_ENQUIRY_ENDPOINT=

# Optional: sub-folder the built site is served from, e.g. /paramedical/
VITE_BASE_PATH=/
